# Stripe Keys
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create these in your Stripe Dashboard → Products)
STRIPE_PRICE_CREATOR_MONTHLY=price_...         # Creator plan — $10/month
STRIPE_PRICE_BUSINESS_MONTHLY=price_...        # Brand Standard — $49/month
STRIPE_PRICE_BRAND_PRO_MONTHLY=price_...       # Brand Pro — $99/month

# App URL (used for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Platform deal fee (9% per completed deal)
NEXT_PUBLIC_PLATFORM_FEE=0.09
